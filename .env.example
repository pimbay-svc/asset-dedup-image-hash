# development | production | test
NODE_ENV=production

# Log level for pino (trace|debug|info|warn|error|fatal|silent).
LOG_LEVEL=info

# Path of the Unix domain socket this extension listens on. Must be on a
# volume shared with asset-dedup-core (core connects to it as a client).
SOCKET_PATH=./var/dev/image-hash.sock

# Python interpreter used to invoke scripts/imagehash_worker.py.
# Set here to the local dev venv from the README's "Quick Start (Local)" section.
PYTHON_BIN=./scripts/.venv/bin/python3

# Path to the Python worker script invoked for every hash request.
# Defaults to scripts/imagehash_worker.py resolved relative to the process cwd.
# IMAGEHASH_WORKER_PATH=./scripts/imagehash_worker.py

# Hard timeout (ms) for a single imagehash_worker.py invocation.
# IMAGEHASH_TIMEOUT_MS=10000
